# ~/.oh-my-zsh is stow-symlinked into packages/zsh, so oh-my-zsh's own files
# (installed at setup time, not dotfiles) live here; only custom/ is ours.
# ~/.local is a real dir in $HOME and stow links only the scripts in
# packages/zsh/.local/bin, so anything else under .local got here by mistake.
packages/zsh/.local/*
!packages/zsh/.local/bin/
packages/zsh/.oh-my-zsh/*
!packages/zsh/.oh-my-zsh/custom/
packages/zsh/.oh-my-zsh/custom/plugins/
packages/zsh/.oh-my-zsh/custom/example.zsh

# wrangler writes a local cache (incl. wrangler-account.json) into the repo root
.wrangler/
