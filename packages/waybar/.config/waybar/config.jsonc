{
  "layer": "top",
  "position": "bottom",
  // Platform: the bar floats on the wallpaper like the windows do (margins
  // match gaps_out) and its modules sit in pills (style.css), not in a row
  // of dividers. Roundhouse, Switchyard and Signal Box anchor to the real
  // surface through bar-anchor, so margins don't move their drawers.
  "height": 34,
  "margin-top": 0,
  "margin-left": 6,
  "margin-right": 6,
  "margin-bottom": 6,
  "spacing": 6,
  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-right": [
    "group/pill-media",
    "group/pill-lamps",
    "group/pill-audio",
    "group/pill-desk",
    "custom/timetable",
    "tray"
  ],
  // Tannoy (~/Sites/tannoy): the cover and now playing share one pill. The
  // daemon follows every MPRIS player over D-Bus and redraws the cover by
  // sending SIGRTMIN+12; both stay empty (and the pill hidden) while nothing
  // plays or do not disturb is on.
  "group/pill-media": {
    "orientation": "horizontal",
    "modules": [
      "image#tannoy-art",
      "custom/tannoy"
    ]
  },
  // The lamps of the programs in ~/Sites: off is dim, on is a color, and a
  // click opens each one's own drawer
  "group/pill-lamps": {
    "orientation": "horizontal",
    "modules": [
      "custom/roundhouse",
      "custom/switchyard",
      "custom/broker",
      "custom/tablet",
      "custom/logbook"
    ]
  },
  "group/pill-audio": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio",
      "custom/mouse-battery"
    ]
  },
  // Plain toggles slide out of the arrow on hover. Anything that is on stays
  // in view: do not disturb and lit key lights leave the drawer.
  "group/pill-desk": {
    "orientation": "horizontal",
    "modules": [
      "custom/silence-notifications#on",
      "custom/keylights#lit",
      "group/desk-drawer"
    ]
  },
  "group/desk-drawer": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 260,
      "transition-left-to-right": false,
      "children-class": "drawer-child"
    },
    "modules": [
      "custom/desk-handle",
      "custom/silence-notifications",
      "custom/keylights",
      "custom/power-menu"
    ]
  },
  "custom/desk-handle": {
    "format": "\uf053",
    "tooltip-format": "Do not disturb, key lights, power"
  },
  "hyprland/workspaces": {
    // A dim number, then a glyph per open window: a mini list of what each
    // workspace holds, with no assumptions about what goes where. An empty
    // workspace shows only its number.
    "format": "<span alpha='55%'>{id}</span>{windows}",
    "format-window-separator": "",
    "window-rewrite-default": " ",
    "window-rewrite": {
      "class<google-chrome>": " ",
      "class<slack>": " ",
      "class<discord>": " ",
      "class<com.t3tools.T3Code>": " ",
      "class<neovide>": " ",
      "class<kitty>": " ",
      "class<float-term>": " ",
      "class<vit>": " ",
      "class<zoom>": " ",
      "class<Godot.*>": " ",
      "class<blender>": " ",
      "class<Emulator>": " "
    },
    "ignore-workspaces": [
      "^1[1-9]$",
      "^[2-9][0-9]+$"
    ]
  },
  "hyprland/window": {
    "max-length": 60,
    "separate-outputs": true,
    // Trade the app's own suffix for its glyph. waybar applies every rule
    // that matches, so keep them mutually exclusive.
    "rewrite": {
      "(.*) - Google Chrome": "  $1",
      "(.*) - Discord": "  $1",
      "(.*?)( - Digital Turbine)? - Slack": "  $1",
      "nate@FROSTYARCH:(.*)": "  $1",
      "~/(.*)": "  ~/$1",
      "T3 Code.*": "  T3 Code",
      "vit": "  tasks"
    }
  },
  "image#tannoy-art": {
    "exec": "~/.local/bin/tannoy art",
    "size": 18,
    "interval": "once",
    "signal": 12,
    "on-click": "~/.local/bin/tannoy toggle",
    "tooltip": false
  },
  // Click opens the drawer (scrub, podcast skips, player pick, output),
  // right-click skips, middle-click pauses, scrolling seeks 5 seconds
  "custom/tannoy": {
    "exec": "~/.local/bin/tannoy bar",
    "return-type": "json",
    "on-click": "~/.local/bin/tannoy toggle",
    "on-click-right": "~/.local/bin/tannoy next",
    "on-click-middle": "~/.local/bin/tannoy play-pause",
    "on-scroll-up": "~/.local/bin/tannoy seek +5",
    "on-scroll-down": "~/.local/bin/tannoy seek -5",
    "tooltip": true
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}% 󰂯",
    "format-muted": " muted",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "hdmi": "󰡁",
      "default": [
        "",
        "",
        ""
      ]
    },
    "tooltip-format": "Output: {desc}\nLeft: switch output · Right: switch input · Middle: mixer",
    "on-click": "~/.config/waybar/scripts/audio-switch.sh output",
    "on-click-right": "~/.config/waybar/scripts/audio-switch.sh input",
    "on-click-middle": "pavucontrol"
  },
  "custom/roundhouse": {
    "exec": "~/.local/bin/rh bar",
    "return-type": "json",
    "on-click": "~/.local/bin/rh toggle",
    "on-click-right": "~/.local/bin/rh toggle --tab storage",
    "tooltip": true
  },
  "custom/mouse-battery": {
    "exec": "~/.config/waybar/scripts/mouse-battery.sh",
    "return-type": "json",
    "interval": 60,
    "format": "{}"
  },
  // Key lights: the drawer holds the lamp while it is off, and
  // custom/keylights#lit shows it beside Logbook while it is on. The toggle
  // redraws both through pkill -RTMIN+10; the poll only catches changes made
  // from the Elgato app or the lightson/lightsoff aliases.
  "custom/keylights": {
    "exec": "~/.config/waybar/scripts/keylights.sh off",
    "return-type": "json",
    "interval": 60,
    "signal": 10,
    "on-click": "~/.config/waybar/scripts/keylights-toggle.sh"
  },
  "custom/keylights#lit": {
    "exec": "~/.config/waybar/scripts/keylights.sh on",
    "return-type": "json",
    "interval": 60,
    "signal": 10,
    "on-click": "~/.config/waybar/scripts/keylights-toggle.sh"
  },
  // swaync streams one JSON line per change; alt is notification, none,
  // dnd-notification or dnd-none (plus inhibited-* while something inhibits)
  "custom/silence-notifications": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "notification": "",
      "none": "",
      "inhibited-notification": "",
      "inhibited-none": "",
      "dnd-notification": "",
      "dnd-none": "",
      "dnd-inhibited-notification": "",
      "dnd-inhibited-none": ""
    },
    "tooltip": false,
    "on-click": "swaync-client -d -sw",
    "on-click-right": "swaync-client -t -sw"
  },  // The same bell outside the drawer, only while do not disturb is on
  // (an empty icon hides the module)
  "custom/silence-notifications#on": {
    "exec": "swaync-client -swb",
    "return-type": "json",
    "format": "{icon}",
    "format-icons": {
      "notification": "",
      "none": "",
      "inhibited-notification": "",
      "inhibited-none": "",
      "dnd-notification": "",
      "dnd-none": "",
      "dnd-inhibited-notification": "",
      "dnd-inhibited-none": ""
    },
    "tooltip": false,
    "on-click": "swaync-client -d -sw",
    "on-click-right": "swaync-client -t -sw"
  },
  // Timetable (~/Sites/timetable, config in packages/timetable): the clock
  // with the next event beside it, from the Google Calendar feed in broker.
  // Amber 10 minutes out, red with Join at start time, a countdown during a
  // focus block. Click opens the drawer (zones, Join, the day strip, focus
  // blocks), right-click opens gnome-calendar, middle-click joins the
  // current or next meeting on workspace 2.
  "custom/timetable": {
    "exec": "~/.local/bin/timetable bar",
    "return-type": "json",
    "on-click": "~/.local/bin/timetable toggle",
    "on-click-right": "gnome-calendar",
    "on-click-middle": "~/.local/bin/timetable join",
    "tooltip": true
  },
  "tray": {
    "spacing": 8
  },
  // Tablet (~/Sites/tablet, config in packages/tablet): the VPN lamp. Dim
  // while off, frost while the tunnel is up and its probes answer, amber
  // while it connects, waits on the sign-in or an agent asks for it, orange
  // when openvpn3 says connected but nothing gets through (stale), red when
  // it failed, dropped or openvpn3 needs a rebuild. Click connects or
  // disconnects (or reconnects what is stale), right-click opens the drawer,
  // middle-click checks now.
  "custom/tablet": {
    "exec": "~/.local/bin/tablet bar",
    "return-type": "json",
    "on-click": "~/.local/bin/tablet flip",
    "on-click-right": "~/.local/bin/tablet toggle",
    "on-click-middle": "~/.local/bin/tablet check"
  },
  // Logbook (~/Sites/logbook): one On Air lamp for the mic. Dim while
  // nothing listens, frost while another app (Zoom, Chrome) has the mic,
  // red with a running clock while a meeting or the screen records, red and
  // pulsing while dictating, amber while a capture saves or a transcript is
  // made. It replaced voxtype-status.sh, meeting-record.sh and
  // screen-record.sh. Click opens the drawer, right-click stops every
  // recording, middle-click dictates.
  "custom/logbook": {
    "exec": "~/.local/bin/logbook bar",
    "return-type": "json",
    "on-click": "~/.local/bin/logbook toggle",
    "on-click-right": "~/.local/bin/logbook stop",
    "on-click-middle": "~/.local/bin/logbook dictate",
    "tooltip": true
  },
  // Switchyard (~/Sites/switchyard, tasks in packages/switchyard): the board of
  // builds, launches and deploys that replaced the games drawer. The signal
  // takes the aggregate state as its CSS class; click opens the board right
  // above it, right-click acknowledges failures. Waybar runs `yard bar` once
  // and leaves the module empty if it exits (killed, or a crash), so
  // restart-interval starts it again after 5 seconds.
  "custom/switchyard": {
    "exec": "~/.local/bin/yard bar",
    "restart-interval": 5,
    "return-type": "json",
    "on-click": "~/.local/bin/yard toggle",
    "on-click-right": "~/.local/bin/yard ack",
    "tooltip": true
  },
  // Signal Box (credential-broker, settings in ~/.config/broker/board.toml):
  // the lamp drains with the soonest grant and turns to a key while an agent
  // is asking. Click opens the panel, right-click opens it on Asks,
  // middle-click revokes every grant.
  "custom/broker": {
    "exec": "/usr/bin/broker bar",
    "return-type": "json",
    "on-click": "/usr/bin/broker board",
    "on-click-right": "/usr/bin/broker board --tab asks",
    "on-click-middle": "/usr/bin/broker revoke --all",
    "tooltip": true
  },
  "custom/power-menu": {
    "format": "⏻",
    "on-click": "~/.config/waybar/scripts/power-menu.sh",
    "tooltip-format": "Power menu"
  }
}
