[Unit]
Description=Mute apps whose windows sit on a muted Hyprland workspace (10 by default, Super+M toggles)
After=pipewire.service wireplumber.service pipewire-pulse.service
Wants=pipewire-pulse.service

[Service]
ExecStart=%h/.config/hypr/scripts/workspace-mute.py daemon
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
